# OpenAI 配置
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

# 数据库配置
DATABASE_URL=mysql+pymysql://ai_teacher:ai_teacher@localhost:3306/ai_teacher
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=ai_teacher
MYSQL_PASSWORD=ai_teacher
MYSQL_DATABASE=ai_teacher

# Redis 配置
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO 配置（知识库 PDF 转 Markdown 后图片存储）
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=ai-teacher
MINIO_BUCKET_NAME=ai-teacher

# RAGFlow 配置（知识库检索与对话编排层，独立部署）
RAGFLOW_BASE_URL=http://localhost:9380
RAGFLOW_API_KEY=your_ragflow_api_key_here

# PDF 处理方式：设为 true 时直接将 PDF 上传 RAGFlow 由服务端解析（无需本地 Marker/MinIO）
# PDF_USE_DIRECT_RAGFLOW=false

# Marker / surya 本地模型缓存
# HF_HOME=C:\Users\Administrator\AppData\Local
# MARKER_MODEL_CACHE=C:\Users\Administrator\AppData\Local
# DATALAB_CACHE_HOME=C:\Users\Administrator\AppData\Local\datalab\datalab\Cache\models
# OMP_NUM_THREADS=1

# 若需和某台已验证可用的服务器环境对齐，可显式指定 checkpoint 版本
# RECOGNITION_MODEL_CHECKPOINT=s3://text_recognition/2025_09_23
# LAYOUT_MODEL_CHECKPOINT=s3://layout/2025_09_23
# DETECTOR_MODEL_CHECKPOINT=s3://text_detection/2025_05_07
# OCR_ERROR_MODEL_CHECKPOINT=s3://ocr_error_detection/2025_02_18
# TABLE_REC_MODEL_CHECKPOINT=s3://table_recognition/2025_02_18

# 应用配置
APP_NAME=AI教师助手
APP_VERSION=1.0.0
DEBUG=True
LOG_LEVEL=INFO

# 安全配置
SECRET_KEY=your_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# 文件存储配置
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
MAX_FILE_SIZE=50MB

# 视频生成配置
MANIM_QUALITY=medium
VIDEO_RESOLUTION=1920x1080
VIDEO_FPS=30

# 文本转语音配置
TTS_LANGUAGE=zh
TTS_VOICE=default
TTS_SPEED=1.0

# 限流配置
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# 监控配置
ENABLE_METRICS=True
METRICS_PORT=9090
